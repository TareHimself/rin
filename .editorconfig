root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# dotnet sln always regenerates this as CRLF+UTF-8-BOM regardless of what's asked for here.
[*.sln]
end_of_line = unset
charset = unset

# Only the ECS backend may reference Friflo (see Engine/Rin.World/BannedSymbols.txt).
[Engine/Rin.World/**.cs]
dotnet_diagnostic.RS0030.severity = error

[Engine/Rin.World/Ecs/Backend/**.cs]
dotnet_diagnostic.RS0030.severity = none
