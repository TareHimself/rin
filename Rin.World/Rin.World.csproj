<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Rin.Core\Rin.Core.csproj" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- Scaffold for the future clustered forward renderer; depends on a pass-graph shape (PreAdd/PostAdd,
             IGraphImage, CollectPass) that predates the current IPass/IGraphConfig API and isn't referenced by
             anything (DefaultWorldRenderer's Default/* pipeline supersedes it). Kept for reference, not compiled. -->
        <Compile Remove="Graphics\ForwardRenderingPass.cs" />
    </ItemGroup>

    <ItemGroup Label="Content">
        <EmbeddedResource Include="Content\**\*.*"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.25"/>
    </ItemGroup>

</Project>
