<Project>

    <!--
        Shared build-time step for C#-authored (Rin.Shade) shaders, backed by the CompileRinShadeShaders
        MSBuild Task (Rin.Shade.MSBuild) - transpiles + compiles + embeds in one in-process step.
        [Shader("...")]-attributed classes are found via ShadeEmitter walking the importing project's own
        compilation, and no .slang file is ever written to the tracked tree. The compiled result is
        embedded directly. To inspect the emitted Slang, build with -p:RinShadeDumpGenerated=true: it is
        written under the project's output directory in GeneratedShaders/ (override with
        RinShadeGeneratedDirectory).

        A consuming project sets, before importing this file:
          <PropertyGroup>
            <RinShadeDiscoverPrefix>...</RinShadeDiscoverPrefix>   the prefix its own [Shader("...")]
                                                                    classes use (Shaders/Rin/Core/,
                                                                    Shaders/Examples/, ...)
            <RinShadeOutputSubpath>...</RinShadeOutputSubpath>     relative to $(IntermediateOutputPath);
                                                                    also the LogicalName's own prefix
          </PropertyGroup>
    -->

    <PropertyGroup>
        <RinShadeRepoRoot Condition="'$(RinShadeRepoRoot)' == ''">$(MSBuildThisFileDirectory)..</RinShadeRepoRoot>
        <RinShadeMSBuildProject Condition="'$(RinShadeMSBuildProject)' == ''">$(MSBuildThisFileDirectory)..\Shade\Rin.Shade.MSBuild\Rin.Shade.MSBuild.csproj</RinShadeMSBuildProject>
        <RinShadeMSBuildAssembly Condition="'$(RinShadeMSBuildAssembly)' == ''">$(MSBuildThisFileDirectory)..\Shade\Rin.Shade.MSBuild\bin\Release\net10.0\Rin.Shade.MSBuild.dll</RinShadeMSBuildAssembly>
    </PropertyGroup>

    <!-- TaskHostFactory runs the task in a short-lived process, so no MSBuild node keeps the task assembly locked. -->
    <UsingTask TaskName="Rin.Shade.MSBuild.CompileRinShadeShaders" AssemblyFile="$(RinShadeMSBuildAssembly)" TaskFactory="TaskHostFactory" />

    <!--
        Brings the task up to date before every use, so a transpiler change takes effect on the next build.
        The output properties are removed so a build with -o still puts the task where RinShadeMSBuildAssembly points.
    -->
    <Target Name="BuildRinShadeMSBuildTask" Condition="'$(RinShadeSkipCompile)' != 'true'">
        <MSBuild Projects="$(RinShadeMSBuildProject)" Targets="Build" Properties="Configuration=Release"
                 RemoveProperties="OutputPath;OutDir;_CommandLineDefinedOutputPath;TargetFramework;RuntimeIdentifier" />
    </Target>

    <!--
        RinShadeSkipCompile opts out entirely for contexts that never
        need a real transpile+compile (e.g. CI running unit tests against fake natives).
    -->
    <Target Name="CompileShadeShaders"
            BeforeTargets="BeforeCompile;AssignTargetPaths"
            DependsOnTargets="ResolveReferences;BuildRinShadeMSBuildTask"
            Condition="'$(RinShadeSkipCompile)' != 'true'">

        <PropertyGroup>
            <RinShadeOutputRoot>$(IntermediateOutputPath)$(RinShadeOutputSubpath)</RinShadeOutputRoot>
            <RinShadeGeneratedDirectory Condition="'$(RinShadeDumpGenerated)' == 'true' AND '$(RinShadeGeneratedDirectory)' == ''">$(OutDir)GeneratedShaders</RinShadeGeneratedDirectory>
        </PropertyGroup>

        <CompileRinShadeShaders
                RepoRoot="$(RinShadeRepoRoot)"
                DiscoverPrefix="$(RinShadeDiscoverPrefix)"
                Sources="@(Compile)"
                References="@(ReferencePath)"
                OutputRoot="$(RinShadeOutputRoot)"
                OutputSubpath="$(RinShadeOutputSubpath)"
                GeneratedDirectory="$(RinShadeGeneratedDirectory)"
                AssemblyName="$(AssemblyName)">
            <Output TaskParameter="CompiledFiles" ItemName="EmbeddedResource" />
        </CompileRinShadeShaders>

    </Target>

</Project>
