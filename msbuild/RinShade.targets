<Project>

    <!--
        Shared build-time step for C#-authored (Rin.Shade) shaders, backed by the CompileRinShadeShaders
        MSBuild Task (Rin.Shade.MSBuild) - transpiles + compiles + embeds in one in-process step. Mirrors
        RinSlang.targets' shape, but is otherwise fully independent of it: [Shader("...")]-attributed
        classes are found via ShadeEmitter walking the importing project's own compilation (no repo-wide
        scan needed, unlike RinSlang's reference-gated discovery), and no .slang file is ever written to
        the tracked Shaders/ tree - the compiled result is embedded directly under a LogicalName computed
        the same way Rin.Slang's own compiled output is.

        A consuming project sets, before importing this file:
          <PropertyGroup>
            <RinShadeDiscoverPrefix>...</RinShadeDiscoverPrefix>   the Shaders/-relative prefix its own
                                                                    [Shader("...")] classes use
            <RinShadeOutputSubpath>...</RinShadeOutputSubpath>     relative to $(IntermediateOutputPath);
                                                                    also the LogicalName's own prefix
          </PropertyGroup>

        RinShadeDiscoverPrefix should be a path segment no project's RinSlangDiscoverPrefix also claims
        (e.g. "Shaders/Rin/World/" alongside Rin.World's own "Shaders/World/") - that's what keeps this
        pipeline and Rin.Slang's from ever both trying to embed the same LogicalName.
    -->

    <PropertyGroup>
        <RinShadeRepoRoot Condition="'$(RinShadeRepoRoot)' == ''">$(MSBuildThisFileDirectory)..</RinShadeRepoRoot>
        <RinShadeMSBuildProject Condition="'$(RinShadeMSBuildProject)' == ''">$(MSBuildThisFileDirectory)..\Shade\Rin.Shade.MSBuild\Rin.Shade.MSBuild.csproj</RinShadeMSBuildProject>
        <RinShadeMSBuildAssembly Condition="'$(RinShadeMSBuildAssembly)' == ''">$(MSBuildThisFileDirectory)..\Shade\Rin.Shade.MSBuild\bin\Release\net10.0\Rin.Shade.MSBuild.dll</RinShadeMSBuildAssembly>
    </PropertyGroup>

    <UsingTask TaskName="Rin.Shade.MSBuild.CompileRinShadeShaders" AssemblyFile="$(RinShadeMSBuildAssembly)" />

    <!--
        Same node-reuse file-lock rationale as RinSlang.targets' BuildRinSlangMSBuildTask: built once,
        explicitly, not auto-rebuilt on every solution build. Delete its bin/ (or
        `dotnet build-server shutdown` first) to pick up a source change.
    -->
    <Target Name="BuildRinShadeMSBuildTask" Condition="'$(RinShadeSkipCompile)' != 'true' AND !Exists('$(RinShadeMSBuildAssembly)')">
        <MSBuild Projects="$(RinShadeMSBuildProject)" Targets="Build" Properties="Configuration=Release" />
    </Target>

    <!--
        RinShadeSkipCompile mirrors RinSlangSkipCompile - opts out entirely for contexts that never
        need a real transpile+compile (e.g. CI running unit tests against fake natives).
    -->
    <Target Name="CompileShadeShaders"
            BeforeTargets="BeforeCompile;AssignTargetPaths"
            DependsOnTargets="ResolveReferences;BuildRinShadeMSBuildTask"
            Condition="'$(RinShadeSkipCompile)' != 'true'">

        <PropertyGroup>
            <RinShadeOutputRoot>$(IntermediateOutputPath)$(RinShadeOutputSubpath)</RinShadeOutputRoot>
        </PropertyGroup>

        <CompileRinShadeShaders
                RepoRoot="$(RinShadeRepoRoot)"
                DiscoverPrefix="$(RinShadeDiscoverPrefix)"
                Sources="@(Compile)"
                References="@(ReferencePath)"
                OutputRoot="$(RinShadeOutputRoot)"
                OutputSubpath="$(RinShadeOutputSubpath)"
                AssemblyName="$(AssemblyName)">
            <Output TaskParameter="CompiledFiles" ItemName="EmbeddedResource" />
        </CompileRinShadeShaders>

    </Target>

</Project>
