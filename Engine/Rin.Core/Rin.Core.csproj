<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>TareHimself.Rin.Core</PackageId>
        <Title>Rin.Core</Title>
        <Authors>TareHimself</Authors>
        <Version>2.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
        <PackageReference Include="NetVips"/>
        <PackageReference Include="NetVips.Native" />
        <PackageReference Include="StbRectPackSharp"/>
        <PackageReference Include="System.Data.SQLite.Core"/>
        <PackageReference Include="TareHimself.Rin.Native"/>
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    </ItemGroup>

    <ItemGroup Label="Content">
        <EmbeddedResource Include="Content\**\*.*"/>
    </ItemGroup>

    <PropertyGroup Label="Slang shaders">
        <RinSlangDiscoverPrefix>Shaders/Core/</RinSlangDiscoverPrefix>
        <RinSlangOutputSubpath>Content\Shaders\Core\</RinSlangOutputSubpath>
    </PropertyGroup>
    <Import Project="$(RinMSBuildDir)RinSlang.targets" />

    <ItemGroup>
      <ProjectReference Include="$(EngineDir)Rin.SourceGenerators\Rin.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <PlatformRID Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</PlatformRID>
        <PlatformRID Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</PlatformRID>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">OS_WINDOWS</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">OS_LINUX</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">OS_MAC</DefineConstants>
        <DefaultItemExcludes>$(DefaultItemExcludes);native\**\*.*;assets\**\*.*</DefaultItemExcludes>
    </PropertyGroup>

</Project>