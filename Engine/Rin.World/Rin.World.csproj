<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="$(EngineDir)Rin.Core\Rin.Core.csproj" />
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- Scaffold for the future clustered forward renderer; depends on a pass-graph shape (PreAdd/PostAdd,
             IGraphImage, CollectPass) that predates the current IPass/IGraphConfig API and isn't referenced by
             anything (DefaultWorldRenderer's Default/* pipeline supersedes it). Kept for reference, not compiled. -->
        <Compile Remove="Graphics\ForwardRenderingPass.cs" />
    </ItemGroup>

    <ItemGroup Label="Content">
        <EmbeddedResource Include="Content\**\*.*"/>
    </ItemGroup>

    <PropertyGroup Label="Slang shaders">
        <RinSlangDiscoverPrefix>Shaders/World/</RinSlangDiscoverPrefix>
        <RinSlangOutputSubpath>Content\Shaders\World\</RinSlangOutputSubpath>
    </PropertyGroup>
    <Import Project="$(RinMSBuildDir)RinSlang.targets" />

    <ItemGroup>
      <ProjectReference Include="$(EngineDir)Rin.SourceGenerators\Rin.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepuPhysics"/>
    </ItemGroup>

</Project>
