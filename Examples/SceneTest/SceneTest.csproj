<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Engine\Rin.World\Rin.World.csproj" />
        <ProjectReference Include="..\..\Engine\Rin.Core\Rin.Core.csproj" />
        <ProjectReference Include="..\Common\Examples.Common.csproj"/>
        <ProjectReference Include="..\..\Experiments\experiments.Docking\experiments.Docking.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SharpGLTF.Core" Version="1.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <assets Include=".\assets\**"/>
        <Content Include="@(assets)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);assets\**\*.*</DefaultItemExcludes>
    </PropertyGroup>

</Project>
