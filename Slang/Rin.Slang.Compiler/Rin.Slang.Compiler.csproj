<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>TareHimself.Rin.Slang.Compiler</PackageId>
        <Title>Rin.Slang.Compiler</Title>
        <Authors>TareHimself</Authors>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <!--    Local refs i.e. project refs-->
    <ItemGroup Condition="'$(DepMode)' == 'local_file'">
        <ProjectReference Include="$(SlangDir)Rin.Slang\Rin.Slang.csproj" />
    </ItemGroup>
    <!--    References from online feeds-->
    <ItemGroup Condition="'$(DepMode)' == 'online'">
        <PackageReference Include="TareHimself.Rin.Slang"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TareHimself.Rin.Slang.Native"/>
    </ItemGroup>

    <PropertyGroup>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">OS_WINDOWS</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">OS_LINUX</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">OS_MAC</DefineConstants>
    </PropertyGroup>

</Project>
