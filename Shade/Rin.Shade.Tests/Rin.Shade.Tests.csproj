<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="NUnit.Analyzers"/>
        <PackageReference Include="NUnit3TestAdapter"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Rin.Shade\Rin.Shade.csproj"/>
        <ProjectReference Include="..\Rin.Shade.Transpiler\Rin.Shade.Transpiler.csproj"/>
        <!-- Plain reference, not OutputItemType="Analyzer" - tests drive the generator directly via
             CSharpGeneratorDriver, entirely in-memory, rather than needing it to actually run as an
             analyzer against this project's own compilation. -->
        <ProjectReference Include="..\Rin.Shade.SourceGenerator\Rin.Shade.SourceGenerator.csproj"/>
        <ProjectReference Include="..\Samples\SampleStdlib\SampleStdlib.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Samples\SampleWorld\SampleWorld.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
