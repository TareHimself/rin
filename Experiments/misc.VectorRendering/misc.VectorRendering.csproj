<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Content">
        <EmbeddedResource Include="Content\**\*.*" Exclude="Content\**\*.slang"/>
    </ItemGroup>

    <ItemGroup Label="Slang shaders">
        <RinSlangSource Include="Content\VectorRendering\**\*.slang" />
    </ItemGroup>
    <PropertyGroup Label="Slang shaders">
        <RinSlangOutputSubpath>Content\VectorRendering\</RinSlangOutputSubpath>
    </PropertyGroup>
    <Import Project="..\..\msbuild\RinSlang.targets" />

    <ItemGroup>
        <ProjectReference Include="..\..\Examples\Common\Examples.Common.csproj"/>
        <ProjectReference Include="..\..\Engine\Rin.Core\Rin.Core.csproj" />
        <ProjectReference Include="..\..\Engine\Rin.Graphics.Vulkan\Rin.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Engine\Rin.Audio.Miniaudio\Rin.Audio.Miniaudio.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SixLabors.Fonts" Version="2.1.3"/>
    </ItemGroup>

</Project>
