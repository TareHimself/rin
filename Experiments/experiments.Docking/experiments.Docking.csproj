<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Windows: no console window -->
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Engine\Rin.Core\Rin.Core.csproj" />
        <ProjectReference Include="..\..\Engine\Rin.Graphics.Vulkan\Rin.Graphics.Vulkan.csproj" />
        <ProjectReference Include="..\..\Engine\Rin.Audio.Miniaudio\Rin.Audio.Miniaudio.csproj" />
        <ProjectReference Include="..\..\Examples\Common\Examples.Common.csproj" />
    </ItemGroup>

</Project>
